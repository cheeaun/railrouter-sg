{
  "extends": "@parcel/config-default",
  "transformers": {
    "*.{jpg,png,svg,geo.json}": ["@parcel/transformer-raw"],
    "*.html": [
      {
        "plugin": "@parcel/transformer-html",
        "config": {
          "optimize": {
            "minifySvg": false
          }
        }
      }
    ]
  }
}
