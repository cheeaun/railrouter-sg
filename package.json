{
  "name": "railrouter-sg",
  "version": "4.0.0",
  "description": "Explore MRT and LRT rail routes in Singapore",
  "keywords": [
    "singapore",
    "mrt",
    "lrt",
    "train",
    "metro",
    "subway",
    "map",
    "transport"
  ],
  "author": "Lim Chee Aun <cheeaun@gmail.com> (http://cheeaun.com/)",
  "license": "MIT",
  "scripts": {
    "start": "parcel serve ./src/index.html --no-hmr",
    "start-https": "parcel serve ./src/index.html --no-hmr --https",
    "build": "parcel build ./src/index.html",
    "postbuild": "cpy 'public/*' dist",
    "postinstall": "node scripts/check-pgf-glyphs-update.mjs",
    "fetch-glyphs": "node scripts/fetch-pgf-glyphs.mjs",
    "gen-style": "node scripts/gen-basemap-style.mjs"
  },
  "dependencies": {
    "fuse.js": "~7.5.0",
    "harfbuzzjs": "^1.6.4",
    "maplibre-gl": "~6.19.0",
    "process": "^0.11.10",
    "workbox-cacheable-response": "~7.4.1",
    "workbox-expiration": "~7.4.1",
    "workbox-google-analytics": "~7.4.1",
    "workbox-routing": "~7.4.1",
    "workbox-strategies": "~7.4.1"
  },
  "devDependencies": {
    "cpy-cli": "~7.0.0",
    "parcel": "^3.0.0-0"
  },
  "browserslist": [
    ">0.25%",
    "not dead",
    "not ie 11",
    "not chrome < 51",
    "not op_mini all",
    "not Android > 1",
    "not safari < 10"
  ]
}
